{
    "permissions": {
      "defaultMode": "bypassPermissions",
      "allow": [
        "Bash",
        "Read",
        "Edit",
        "WebFetch",
        "WebSearch"
      ],
      "deny": [
        "Read(**/archive/**)",
        "Edit(**/archive/**)",
        "Read(**/Archive/**)",
        "Edit(**/Archive/**)"
      ]
    },
    "sandbox": {
      "enabled": true,
      "autoAllowBashIfSandboxed": true
    }
  }

